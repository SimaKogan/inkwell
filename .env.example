# Copy to .env before `docker compose up`.

# Required. At least 32 random bytes:  openssl rand -base64 48
INKWELL_JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef

POSTGRES_PASSWORD=inkwell

# Optional: enables Claude-vision handwriting recognition and the "Ask AI" panel.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# true = fill an empty database with multilingual demo data (users demo/admin, password demo12345 / admin12345).
INKWELL_SEED=true
